{
  "name": "@live-codes/ocaml",
  "version": "0.1.0",
  "description": "Run OCaml in the browser - a real OCaml toplevel compiled to JavaScript, with no server",
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "ocaml-copy-assets": "./bin/copy-assets.mjs"
  },
  "files": [
    "src",
    "bin",
    "assets",
    "README.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ocaml",
    "toplevel",
    "compiler",
    "playground"
  ]
}
