{
  "name": "@live-codes/ocaml",
  "version": "0.1.1",
  "description": "Run OCaml in the browser with no server: a compiler that emits JavaScript, and a toplevel that runs OCaml directly",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/live-codes/browser-ocaml.git",
    "directory": "packages/ocaml"
  },
  "homepage": "https://github.com/live-codes/browser-ocaml#readme",
  "bugs": "https://github.com/live-codes/browser-ocaml/issues",
  "type": "module",
  "license": "LGPL-2.1-or-later WITH OCaml-LGPL-linking-exception",
  "exports": {
    ".": "./src/index.js",
    "./compiler": "./src/compiler/index.js",
    "./interpreter": "./src/interpreter/index.js"
  },
  "bin": {
    "ocaml-copy-assets": "./bin/copy-assets.mjs"
  },
  "files": [
    "src",
    "bin",
    "assets",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ocaml",
    "compiler",
    "toplevel",
    "playground",
    "browser"
  ]
}
