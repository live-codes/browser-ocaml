; The toplevel worker.
;
; Compiles to OCaml bytecode, which is then turned into JavaScript by
; js_of_ocaml with the --toplevel flag (see ../Makefile).

(executable
 (name worker)
 (modes byte)
 (modules worker)
 (libraries
  dynlink
  js_of_ocaml
  js_of_ocaml-toplevel
  js_of_ocaml-compiler.dynlink
  compiler-libs.common)
 (link_flags
  (-linkall)))
